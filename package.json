{
  "name": "dinasty-sports",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "RPG de deportes y vida escolar basado en decisiones. Arquitectura modular.",
  "workspaces": [
    "packages/*",
    "modules/*",
    "apps/*",
    "sim"
  ],
  "scripts": {
    "dev": "npm run dev -w @ds/web",
    "build": "npm run build -w @ds/web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "tsx sim/src/cli.ts",
    "sim:rapida": "tsx sim/src/cli.ts --dias 84 --semillas 2",
    "huella": "tsx tools/huella.ts",
    "rendimiento": "tsx tools/rendimiento.ts",
    "sim:largo": "tsx sim/src/cli.ts --dias 1095 --semillas 3",
    "check": "npm run typecheck && npm run test && npm run sim:rapida",
    "nuevo-modulo": "tsx tools/nuevo-modulo.ts",
    "sim:vida": "tsx sim/src/vida.ts",
    "sim:notas": "tsx sim/src/notas.ts",
    "clave-deportes": "tsx tools/clave-deportes.ts",
    "publicar-deportes": "tsx tools/publicar-deportes.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
